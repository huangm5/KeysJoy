<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4466cc" />
            <corners android:radius="3dp" />
            <stroke android:width="1dp" android:color="#2255aa" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_modifier_hold_bg" />
            <corners android:radius="3dp" />
            <stroke android:width="0.5dp" android:color="@color/key_modifier_hold_border" />
        </shape>
    </item>
</selector>
